# Copy to deploy/.env on the server. Never commit the real file.
DOMAIN=squamishbuses.ca
POSTGRES_PASSWORD=change-me-to-a-long-random-string
GITHUB_OWNER=change-me
IMAGE_TAG=latest
# Optional: upload the daily archive bundles to S3 with the instance's IAM role
# (docs/RUNBOOK.md). Leave S3_BUCKET empty to keep bundles local for a NAS to pull.
S3_BUCKET=
S3_PREFIX=bundles/
AWS_REGION=ca-central-1
# Optional: also copy the nightly database dumps (deploy/backup.sh) to an rclone remote
RCLONE_REMOTE=
