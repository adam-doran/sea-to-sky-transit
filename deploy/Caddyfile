# TLS is automatic (Let's Encrypt). Put Cloudflare (or another CDN) in front:
# the API's Cache-Control headers let it absorb nearly all traffic.
{$DOMAIN} {
	encode zstd gzip

	# API: documents pre-built by the collector. Never touches BC Transit.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Self-hosted vector map tiles (PMTiles). file_server supports the HTTP
	# range requests the map library uses to read them.
	handle /tiles/* {
		root * /srv
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# The web app: hashed assets cache forever, everything else is the SPA.
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
	}
}
