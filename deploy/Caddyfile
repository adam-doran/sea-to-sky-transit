# TLS is automatic (Let's Encrypt). Put Cloudflare (or another CDN) in front:
# the API's Cache-Control headers let it absorb nearly all traffic.
{$DOMAIN} {
	encode zstd gzip

	# API: documents pre-built by the collector. Never touches BC Transit.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Self-hosted vector map tiles (PMTiles). file_server supports the HTTP
	# range requests the map library uses to read them.
	handle /tiles/* {
		root * /srv
		header Cache-Control "public, max-age=604800"
		file_server
	}

	# Map fonts and icons: pinned by deploy/map-assets/fetch.sh, so safe to cache
	handle /map-assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	# The web app: hashed assets cache forever, everything else is the SPA.
	handle /assets/* {
		root * /srv/web
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		root * /srv/web
		try_files {path} /index.html
		header /index.html Cache-Control "no-cache"
		# The offline worker must always be checked for a new version
		header /sw.js Cache-Control "no-cache"
		header /manifest.webmanifest Cache-Control "public, max-age=86400"
		header /icons/* Cache-Control "public, max-age=604800"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self), camera=(), microphone=()"
		# Same-origin only. MapLibre runs its worker from a blob: URL. The hash is
		# the theme script inline in web/index.html (a web unit test checks it),
		# and `vite preview` serves this policy so the e2e tests run under it.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-QaFSAWCpP9ltzKjNnuiQja+uxaH0sUZKenXF7J6I5Ow='; worker-src 'self' blob:; child-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
	}
}
