{
  "name": "layover-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests e2e playwright.config.ts",
    "test": "vitest run",
    "e2e": "playwright test",
    "api-types": "openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@preact/signals": "2.11.2",
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.11.2",
    "pmtiles": "4.5.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
